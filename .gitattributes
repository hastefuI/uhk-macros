# Normalize line endings: LF in the repository, native on checkout.
* text=auto eol=lf

# Explicit types for the files this repo actually carries.
*.md        text diff=markdown
*.uhkm      text
LICENSE     text

# UHKM macro files are plain text with `//` comments and quoted strings, so
# borrow C highlighting on GitHub. They are this repository's source, so keep
# them in the language statistics bar.
*.uhkm      linguist-language=C linguist-detectable=true

# Repository scaffolding does not belong in release archives.
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
.github/        export-ignore
.claude/        export-ignore
